VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
# Botón "Continuar con Google" en el login (activar sólo después de habilitar el proveedor en Supabase Auth)
VITE_GOOGLE_LOGIN=false

# Google Calendar (sin prefijo VITE_: nunca llegan al navegador; se cargan con `supabase secrets set`)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
APP_URL=http://localhost:5173

# Generación de planes de alimentación con IA (Gemini). Se usa la misma API key de Google AI Studio
# (nunca con prefijo VITE_: sólo la usa la Edge Function `mealplan`, cargada con `supabase secrets set`).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
